# Hospedagem Apache/LiteSpeed (ex.: Hostinger). O Vite copia este arquivo para dist/.
# Suba o CONTEÚDO de dist/ (depois de `npm run build`) para public_html/.

# O site é uma SPA (React Router): endereço que não é arquivo de verdade
# (/dashboard, /turmas/..., /banca/...) abre o index.html, e o React escolhe a página.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # A página Contato saiu (os dados estão no rodapé): 301 para a Home
  RewriteRule ^contato/?$ / [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Arquivos do build têm hash no nome: podem ficar em cache por 1 ano
  <FilesMatch "\.(js|css|woff2?|webp|png|jpg|svg|ico|tflite)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # O index.html nunca fica velho (senão o navegador pede arquivos que não existem mais)
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Segurança básica: sem adivinhar tipo, sem ser aberto dentro de outro site,
  # e o endereço completo (com link pessoal) não vai para outros sites
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Sem listagem de pastas
Options -Indexes
